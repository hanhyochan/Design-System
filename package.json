{
  "name": "h_designsystem",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "storybook": "npm run storybook --workspace=@h_designsystem/storybook",
    "build": "npm run build --workspace=@h_designsystem/foundation && npm run build --workspace=@h_designsystem/ui",
    "build-storybook": "npm run build-storybook --workspace=@h_designsystem/storybook",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/storybook/tsconfig.json --noEmit",
    "pack": "npm run build && npm pack --workspace=@h_designsystem/tokens --workspace=@h_designsystem/foundation --workspace=@h_designsystem/ui"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
