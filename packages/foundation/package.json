{
  "name": "@h_designsystem/foundation",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src/icons",
    "src/style/reset.css"
  ],
  "dependencies": {
    "@h_designsystem/tokens": "0.1.0"
  },
  "exports": {
    ".": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./src/style/reset.css",
    "./icons/*": "./src/icons/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "sass src/style/index.scss dist/styles.css --no-source-map",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.106.1"
  }
}
