{
  "name": "@h_designsystem/foundation",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "src/icons",
    "src/style/reset.css"
  ],
  "dependencies": {
    "@h_designsystem/tokens": "0.2.0"
